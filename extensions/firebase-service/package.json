{
  "name": "firebase-service",
  "displayName": "Firebase Service",
  "description": "Firebase Analytics and Data Storage services for VS Code",
  "version": "1.0.0",
  "publisher": "ConscendoTechInc",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:firebase-service.initialize",
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "firebase-service-activitybar",
          "title": "Firebase Service",
          "icon": "$(flame)"
        }
      ]
    },
    "views": {
      "firebase-service-activitybar": [
        {
          "id": "firebaseServiceExplorer",
          "name": "Firebase Service",
          "when": "true",
          "icon": "$(flame)"
        }
      ]
    },
    "commands": [
      {
        "command": "firebase-service.initialize",
        "title": "Initialize Firebase Service",
        "category": "FBS"
      },
      {
        "command": "firebase-service.signIn",
        "title": "Sign In",
        "category": "FBS",
        "icon": "$(sign-in)"
      },
      {
        "command": "firebase-service.signOut",
        "title": "Sign Out",
        "category": "FBS",
        "icon": "$(sign-out)"
      },
      {
        "command": "firebase-service.getUser",
        "title": "Get Current User",
        "category": "FBS",
        "icon": "$(account)"
      },
      {
        "command": "firebase-service.storeData",
        "title": "Store Data in Firestore",
        "category": "FBS",
        "icon": "$(add)"
      },
      {
        "command": "firebase-service.retrieveData",
        "title": "Retrieve Data from Firestore",
        "category": "FBS",
        "icon": "$(search)"
      },
      {
        "command": "firebase-service.storeDataInteractive",
        "title": "Store Data (Interactive)",
        "category": "FBS",
        "icon": "$(add)"
      },
      {
        "command": "firebase-service.retrieveDataInteractive",
        "title": "Retrieve Data (Interactive)",
        "category": "FBS",
        "icon": "$(search)"
      },
      {
        "command": "firebase-service.showAuthStatus",
        "title": "Show Authentication Status",
        "category": "FBS"
      },
      {
        "command": "firebase-service.refreshSession",
        "title": "Refresh Session",
        "category": "FBS",
        "icon": "$(refresh)"
      },
      {
        "command": "firebase-service.testAuthFlow",
        "title": "Test Authentication Flow",
        "category": "FBS Debug"
      },
      {
        "command": "firebase-service.api.getUserDetails",
        "title": "Get User Details (API)",
        "category": "FBS API"
      },
      {
        "command": "firebase-service.api.isAuthenticated",
        "title": "Check Authentication Status (API)",
        "category": "FBS API"
      },
      {
        "command": "firebase-service.api.getUserId",
        "title": "Get User ID (API)",
        "category": "FBS API"
      },
      {
        "command": "firebase-service.runAPITests",
        "title": "Run API Tests (Full Suite)",
        "category": "FBS Debug"
      },
      {
        "command": "firebase-service.quickTest",
        "title": "Quick API Test",
        "category": "FBS Debug"
      },
      {
        "command": "firebase-service.testMethod",
        "title": "Test Specific API Method",
        "category": "FBS Debug"
      }
    ],
    "authentication": [
      {
        "id": "firebase",
        "label": "Firebase Authentication"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "firebase-service.initialize",
          "when": "true"
        },
        {
          "command": "firebase-service.signIn",
          "when": "true"
        },
        {
          "command": "firebase-service.signOut",
          "when": "firebase-service.authenticated"
        },
        {
          "command": "firebase-service.getUser",
          "when": "firebase-service.authenticated"
        },
        {
          "command": "firebase-service.storeData",
          "when": "firebase-service.authenticated"
        },
        {
          "command": "firebase-service.retrieveData",
          "when": "firebase-service.authenticated"
        },
        {
          "command": "firebase-service.showAuthStatus",
          "when": "true"
        }
      ],
      "AccountsContext": [
        {
          "command": "firebase-service.signIn",
          "when": "!firebase-service.authenticated",
          "group": "1_firebase@1"
        },
        {
          "command": "firebase-service.signOut",
          "when": "firebase-service.authenticated",
          "group": "1_firebase@2"
        },
        {
          "command": "firebase-service.getUser",
          "when": "firebase-service.authenticated",
          "group": "1_firebase@3"
        },
        {
          "command": "firebase-service.showAuthStatus",
          "when": "true",
          "group": "1_firebase@4"
        },
        {
          "command": "firebase-service.refreshSession",
          "when": "firebase-service.authenticated",
          "group": "1_firebase@5"
        },
        {
          "command": "firebase-service.storeDataInteractive",
          "when": "firebase-service.authenticated",
          "group": "2_firebase_data@1"
        },
        {
          "command": "firebase-service.retrieveDataInteractive",
          "when": "firebase-service.authenticated",
          "group": "2_firebase_data@2"
        }
      ],
      "view/title": [
        {
          "command": "firebase-service.signIn",
          "when": "view == firebaseServiceExplorer && !firebase-service.authenticated",
          "group": "navigation"
        },
        {
          "command": "firebase-service.signOut",
          "when": "view == firebaseServiceExplorer && firebase-service.authenticated",
          "group": "navigation"
        },
        {
          "command": "firebase-service.refreshSession",
          "when": "view == firebaseServiceExplorer && firebase-service.authenticated",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "firebase-service.storeData",
          "when": "view == firebaseServiceExplorer && viewItem == firestore",
          "group": "inline"
        },
        {
          "command": "firebase-service.retrieveData",
          "when": "view == firebaseServiceExplorer && viewItem == firestore",
          "group": "inline"
        }
      ]
    },
    "uriHandlers": [
      {
        "protocol": "siid",
        "label": "Firebase Service URI Handler"
      }
    ],
    "configuration": {
      "title": "Firebase Service",
      "properties": {
        "firebase-service.apiKey": {
          "type": "string",
          "default": "",
          "description": "Firebase API Key"
        },
        "firebase-service.authDomain": {
          "type": "string",
          "default": "",
          "description": "Firebase Auth Domain"
        },
        "firebase-service.projectId": {
          "type": "string",
          "default": "",
          "description": "Firebase Project ID"
        },
        "firebase-service.storageBucket": {
          "type": "string",
          "default": "",
          "description": "Firebase Storage Bucket"
        },
        "firebase-service.messagingSenderId": {
          "type": "string",
          "default": "",
          "description": "Firebase Messaging Sender ID"
        },
        "firebase-service.appId": {
          "type": "string",
          "default": "",
          "description": "Firebase App ID"
        },
        "firebase-service.enableDataStorage": {
          "type": "boolean",
          "default": true,
          "description": "Enable Firebase Firestore data storage"
        },
        "firebase-service.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for Firebase Service"
        },
        "firebase-service.privacyConsent": {
          "type": "boolean",
          "default": false,
          "description": "User consent for data collection and analytics"
        },
        "firebase-service.eventBatchSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Number of events to batch before sending to Firebase"
        },
        "firebase-service.authPageUrl": {
          "type": "string",
          "default": "https://salesforce-ide-c1761.web.app/auth",
          "description": "URL of your external Firebase authentication page"
        },
        "firebase-service.enableTestMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable test mode to bypass authentication validation for debugging"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@firebase/app": "^0.14.2",
    "@firebase/auth": "^1.11.0",
    "@firebase/firestore": "^4.9.1",
    "dotenv": "^17.2.2",
    "uuid": "^9.0.0"
  }
}
